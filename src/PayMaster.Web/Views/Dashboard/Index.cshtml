@model PayMaster.Application.Dashboard.DashboardData
@{
    ViewData["Title"] = "Dashboard";
    var first = Ui.DisplayName(User).Split(' ')[0];
    var p = Model.CurrentPeriod;
    var perf = Model.Performance;
    (string, decimal)[] breakdown = p is null ? [] : [("PAYE", p.TotalPaye), ("SHIF", p.TotalSha), ("Housing Levy", p.TotalHousingLevy), ("NSSF", p.TotalNssf), ("Other", p.OtherDeductions)];
    var hour = Ui.ToLocal(DateTime.UtcNow).Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var perfTrend = perf?.Trend.Where(t => t.Score is not null).ToList() ?? [];
}

<div class="page-header">
    <div>
        <h1 class="page-title">@greeting, @first</h1>
        <p class="page-subtitle">
            @if (Model.ShowPayroll && p is not null)
            {
                <text>@p.PeriodName payroll is <strong>@(p.Status is { } st ? Ui.StatusLabel(st).ToLowerInvariant() : "not started")</strong>.</text>
            }
            else
            {
                <text>Here's what's happening today.</text>
            }
        </p>
    </div>
    @if (Model.ShowPayroll)
    {
        <div class="page-actions">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-bar-chart-line me-1"></i> Reports</a>
            <a asp-controller="Payroll" asp-action="Index" class="btn btn-primary"><i class="bi bi-play-circle me-1"></i> Run Payroll</a>
        </div>
    }
</div>

@if (Model.ShowPayroll || Model.ShowPeople)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xxl">
            <div class="kpi-card kpi-blue"><span class="kpi-icon"><i class="bi bi-people"></i></span>
                <div><div class="kpi-label">Total Employees</div><div class="kpi-value">@Model.TotalEmployees</div><div class="kpi-trend trend-up"><i class="bi bi-arrow-up"></i> @Model.NewThisMonth new this month</div></div></div>
        </div>
        @if (Model.ShowPayroll)
        {
            <div class="col-sm-6 col-xxl">
                <div class="kpi-card kpi-green"><span class="kpi-icon"><i class="bi bi-cash-coin"></i></span>
                    <div><div class="kpi-label">Total Gross Payroll</div><div class="kpi-value">@Ui.MoneyShort(p?.TotalGross ?? 0)</div><div class="kpi-trend trend-flat">@(p?.PeriodName ?? "No payroll yet")</div></div></div>
            </div>
            <div class="col-sm-6 col-xxl">
                <div class="kpi-card kpi-red"><span class="kpi-icon"><i class="bi bi-currency-exchange"></i></span>
                    <div><div class="kpi-label">Total Deductions</div><div class="kpi-value">@Ui.MoneyShort(p?.TotalDeductions ?? 0)</div><div class="kpi-trend trend-flat">PAYE @Ui.MoneyShort(p?.TotalPaye ?? 0)</div></div></div>
            </div>
            <div class="col-sm-6 col-xxl">
                <div class="kpi-card kpi-purple"><span class="kpi-icon"><i class="bi bi-wallet2"></i></span>
                    <div><div class="kpi-label">Total Net Payroll</div><div class="kpi-value">@Ui.MoneyShort(p?.TotalNetPay ?? 0)</div><div class="kpi-trend trend-flat">Employer +@Ui.MoneyShort(p?.EmployerContributions ?? 0)</div></div></div>
            </div>
            <div class="col-sm-6 col-xxl">
                <div class="kpi-card kpi-orange"><span class="kpi-icon"><i class="bi bi-hourglass-split"></i></span>
                    <div><div class="kpi-label">Pending Approvals</div><div class="kpi-value">@Model.PendingPayrollApprovals</div><div class="kpi-trend trend-flat">@Model.Approvals.Count items need action</div></div></div>
            </div>
        }
    </div>
}

@if (Model.ShowPayroll)
{
    <div class="row gap-row mb-4">
        <div class="col-xl-8">
            <div class="card-pm h-100">
                <div class="card-pm-header"><div><h2 class="card-pm-title">Monthly payroll trend</h2><p class="card-pm-subtitle">Finalized gross and net pay</p></div></div>
                <div class="card-pm-body">
                    @if (Model.Trend.Count == 0)
                    {
                        <p class="text-muted mb-0">The trend appears after the first payroll is finalized.</p>
                    }
                    else
                    {
                        <div class="chart-box"><canvas role="img" aria-label="Monthly gross and net payroll" data-chart='@Charts.Lines(Model.Trend.Select(t => t.Label), ("Gross pay", Model.Trend.Select(t => t.Gross)), ("Net pay", Model.Trend.Select(t => t.Net)))'></canvas></div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card-pm h-100">
                <div class="card-pm-header"><div><h2 class="card-pm-title">Deductions breakdown</h2><p class="card-pm-subtitle">@(p?.PeriodName)</p></div></div>
                <div class="card-pm-body">
                    @if (breakdown.Sum(b => b.Item2) == 0)
                    {
                        <p class="text-muted mb-0">No deductions yet.</p>
                    }
                    else
                    {
                        var total = breakdown.Sum(b => b.Item2);
                        <div class="position-relative mx-auto mb-3" style="width:170px;height:170px;">
                            <canvas role="img" aria-label="Deductions by type" data-chart='@Charts.Doughnut(breakdown.Select(b => b.Item1), breakdown.Select(b => b.Item2))'></canvas>
                            <div class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events:none;"><div class="small text-muted">Total</div><div class="fw-bold money">@Ui.MoneyShort(total)</div></div>
                        </div>
                        <ul class="legend-list">
                            @for (var i = 0; i < breakdown.Length; i++)
                            {
                                <li><span class="legend-swatch" style="background:@Charts.Series[i]"></span><span>@breakdown[i].Item1</span><span class="legend-value">@Ui.MoneyShort(breakdown[i].Item2)</span><span class="legend-pct">@Ui.Percent(breakdown[i].Item2 / total)</span></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (Model.ShowPeople || Model.ShowPerformance)
{
    <div class="row gap-row mb-4">
        @if (Model.ShowPeople && Model.Headcount.Count > 0)
        {
            <div class="col-xl-6">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><div><h2 class="card-pm-title">Employees by department</h2><p class="card-pm-subtitle">Active headcount</p></div></div>
                    <div class="card-pm-body">
                        <div style="position:relative;height:@(Math.Max(180, Model.Headcount.Count * 36))px;">
                            <canvas role="img" aria-label="Headcount by department" data-chart='@Charts.Bars(Model.Headcount.Select(h => h.Department), "Employees", Model.Headcount.Select(h => (decimal)h.Count), horizontal: true)'></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (Model.ShowPerformance && perf is not null)
        {
            <div class="col-xl-6">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><div><h2 class="card-pm-title">Performance trend</h2><p class="card-pm-subtitle">Average finalized score by review cycle · @(perf.AverageScore?.ToString("0.00") ?? "—") overall</p></div>
                        <a asp-controller="Performance" asp-action="Index" class="small fw-semibold">Details</a></div>
                    <div class="card-pm-body">
                        @if (perfTrend.Count == 0)
                        {
                            <p class="text-muted mb-0">Scores appear once reviews are finalized.</p>
                        }
                        else
                        {
                            <div class="chart-box-sm"><canvas role="img" aria-label="Average review score per cycle" data-chart='@Charts.Bars(perfTrend.Select(t => t.Label), "Average score", perfTrend.Select(t => t.Score ?? 0), max: 5)'></canvas></div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row gap-row">
    @if (Model.ShowPayroll)
    {
        <div class="col-xl-8">
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Recent payroll runs</h2><a asp-controller="PayrollHistory" asp-action="Index" class="small fw-semibold">View all</a></div>
                <div class="card-pm-body">
                    @if (Model.RecentRuns.Count == 0)
                    {
                        <p class="text-muted mb-0">No payroll runs yet.</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="table table-pm">
                                <thead><tr><th>Period</th><th>Reference</th><th class="text-end">Employees</th><th class="text-end">Gross</th><th class="text-end">Net</th><th>Status</th></tr></thead>
                                <tbody>
                                @foreach (var r in Model.RecentRuns)
                                {
                                    <tr data-href="@Url.Action("Run", "Payroll", new { id = r.Id })" style="cursor:pointer;">
                                        <td class="fw-semibold">@r.PeriodName</td><td><a asp-controller="Payroll" asp-action="Run" asp-route-id="@r.Id">@r.Reference</a></td>
                                        <td class="text-end">@r.EmployeeCount</td><td class="text-end money">@Ui.MoneyShort(r.TotalGross)</td><td class="text-end money">@Ui.MoneyShort(r.TotalNetPay)</td>
                                        <td><span class="status @Ui.StatusCss(r.Status)">@Ui.StatusLabel(r.Status)</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            @if (Model.ShowPeople)
            {
                <div class="card-pm">
                    <div class="card-pm-header"><h2 class="card-pm-title">Newest employees</h2><a asp-controller="Employees" asp-action="Index" asp-route-sortBy="hired" asp-route-sortDescending="true" class="small fw-semibold">All employees</a></div>
                    <div class="card-pm-body">
                        <ul class="list-clean d-grid gap-3">
                            @foreach (var e in Model.RecentHires)
                            {
                                <li class="d-flex justify-content-between align-items-center">
                                    <span class="person"><span class="avatar avatar-sm @Ui.AvatarClass(e.EmployeeNumber)">@Ui.Initials(e.Name)</span><span><a asp-controller="Employees" asp-action="Details" asp-route-id="@e.Id" class="person-name">@e.Name</a><span class="d-block person-meta">@(e.JobTitle ?? "—") · @e.Department</span></span></span>
                                    <span class="small text-muted">Joined @Ui.Date(e.EmploymentDate)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
        <div class="col-xl-4">
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Pending approvals</h2></div>
                <div class="card-pm-body">
                    @if (Model.Approvals.Count == 0)
                    {
                        <p class="text-muted mb-0"><i class="bi bi-check2-circle text-success me-1"></i> Nothing waiting for approval.</p>
                    }
                    else
                    {
                        <ul class="list-clean d-grid gap-3">
                            @foreach (var a in Model.Approvals)
                            {
                                <li><a href="@a.Link" class="fw-semibold">@a.Title</a><span class="d-block small text-muted">@a.Kind · @a.Detail</span></li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Quick actions</h2></div>
                <div class="card-pm-body">
                    <div class="quick-actions">
                        @if (User.Can(Permissions.Employees.Manage)) { <a class="quick-action" asp-controller="Employees" asp-action="Create"><i class="bi bi-person-plus"></i> Add Employee</a> }
                        @if (User.Can(Permissions.Payroll.Process)) { <a class="quick-action" asp-controller="Payroll" asp-action="Index"><i class="bi bi-play-circle"></i> Run Payroll</a> }
                        <a class="quick-action" asp-controller="Payslips" asp-action="Index"><i class="bi bi-receipt"></i> Payslips</a>
                        <a class="quick-action" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> View Reports</a>
                        @if (User.Can(Permissions.Performance.ManageCycles)) { <a class="quick-action" asp-controller="Reviews" asp-action="Index"><i class="bi bi-clipboard-plus"></i> Create Review</a> }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.ShowPerformance && perf is not null && perf.UpcomingReviews.Count > 0)
    {
        <div class="@(Model.ShowPayroll ? "col-12" : "col-xl-8")">
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Upcoming performance reviews</h2><a asp-controller="Reviews" asp-action="Index" class="small fw-semibold">All reviews</a></div>
                <div class="card-pm-body"><partial name="~/Views/Reviews/_ReviewRows.cshtml" model="perf.UpcomingReviews" /></div>
            </div>
        </div>
    }

    @if (Model.IsSelfService || (!Model.ShowPayroll && perf is not null))
    {
        <div class="col-xl-4">
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">My latest payslip</h2><a asp-controller="Payslips" asp-action="Index" class="small fw-semibold">All payslips</a></div>
                <div class="card-pm-body">
                    @if (Model.LatestPayslip is { } slip)
                    {
                        <div class="small-caps">@slip.PeriodName</div>
                        <div class="fs-3 fw-bold money text-success my-1">@Ui.Money(slip.NetPay)</div>
                        <div class="small text-muted mb-3">Net pay · gross @Ui.MoneyShort(slip.GrossEarnings) · paid @Ui.Date(slip.PaymentDate)</div>
                        <a asp-controller="Payslips" asp-action="Pdf" asp-route-id="@slip.Id" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i> Download PDF</a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No payslips yet.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">My goals</h2><a asp-controller="Performance" asp-action="Index" class="small fw-semibold">My performance</a></div>
                <div class="card-pm-body">
                    @if (perf is null || perf.MyGoals.Count == 0)
                    {
                        <p class="text-muted mb-0">No goals assigned yet.</p>
                    }
                    else
                    {
                        <ul class="list-clean d-grid gap-3">
                            @foreach (var g in perf.MyGoals.Take(5))
                            {
                                <li>
                                    <div class="d-flex justify-content-between"><a asp-controller="Goals" asp-action="Details" asp-route-id="@g.Id" class="fw-semibold">@g.Title</a><span class="status @Ui.StatusCss(g.Status)">@Ui.Humanize(g.Status)</span></div>
                                    <div class="d-flex align-items-center gap-2 mt-1"><div class="progress flex-grow-1"><div class="progress-bar" style="width:@g.Progress%"></div></div><span class="small text-muted">@g.Progress%</span></div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
