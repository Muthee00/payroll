@using PayMaster.Application.Performance
@model ReviewDetails
@{
    var r = Model.Review;
    ViewData["Title"] = $"Review — {r.EmployeeName}";
    var stages = new[] { ReviewStatus.PendingManagerEvaluation, ReviewStatus.PendingSelfAssessment, ReviewStatus.PendingManagerFeedback, ReviewStatus.PendingAcknowledgement, ReviewStatus.PendingHrFinalization, ReviewStatus.Finalized };
    var current = Array.IndexOf(stages, r.Status);
    var canScore = Model.IsReviewer && r.Status is ReviewStatus.PendingManagerEvaluation or ReviewStatus.PendingManagerFeedback;
    string Text(string? t) => string.IsNullOrWhiteSpace(t) ? "—" : t;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Reviews</a></li>
        <li class="breadcrumb-item active" aria-current="page">@r.EmployeeName</li>
    </ol>
</nav>
<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar avatar-lg @Ui.AvatarClass(r.EmployeeNumber)">@Ui.Initials(r.EmployeeName)</span>
        <div>
            <h1 class="page-title mb-0">@r.EmployeeName</h1>
            <p class="page-subtitle mt-1">@(Model.JobTitle ?? "—") · @r.DepartmentName · @r.CycleName (@Ui.Date(Model.PeriodStart) – @Ui.Date(Model.PeriodEnd)) · reviewer @(r.ReviewerName ?? "HR")</p>
        </div>
    </div>
    <div class="page-actions">
        @if (r.OverallScore is decimal score)
        {
            <div class="text-end me-2"><div class="small text-muted">Overall</div><div class="fs-4 fw-bold">@score.ToString("0.00")<span class="fs-6 text-muted"> / 5</span></div><div class="small fw-semibold">@r.OverallRating</div></div>
        }
        @if (Model.IsHr && r.Status is not (ReviewStatus.Finalized or ReviewStatus.Cancelled))
        {
            <form method="post" asp-action="Cancel" asp-route-id="@r.Id" data-confirm="Cancel this review?" data-confirm-variant="danger" data-confirm-button="Cancel review">
                <button class="btn btn-outline-secondary">Cancel</button>
            </form>
        }
    </div>
</div>

@if (r.Status != ReviewStatus.Cancelled)
{
    <div class="card-pm mb-4">
        <div class="card-pm-body">
            <ol class="list-clean d-flex flex-wrap gap-3 mb-0">
                @for (var i = 0; i < stages.Length; i++)
                {
                    var done = i < current || r.Status == ReviewStatus.Finalized;
                    var active = i == current && r.Status != ReviewStatus.Finalized;
                    <li class="d-flex align-items-center gap-2 small @(active ? "fw-semibold text-primary" : done ? "text-success" : "text-muted")">
                        <i class="bi @(done ? "bi-check-circle-fill" : active ? "bi-record-circle" : "bi-circle")"></i> @Ui.ReviewStage(stages[i])
                        @if (i < stages.Length - 1) { <i class="bi bi-chevron-right text-muted ms-2"></i> }
                    </li>
                }
            </ol>
            @if (r.IsOverdue) { <div class="text-danger small mt-2"><i class="bi bi-alarm"></i> Overdue — was due @Ui.Date(r.DueDate)</div> }
        </div>
    </div>
}

<div class="row gap-row">
    <div class="col-xl-8">
        @if (canScore)
        {
            <form method="post" asp-action="Evaluate" asp-route-id="@r.Id" class="card-pm mb-4">
                <div class="card-pm-header"><div><h2 class="card-pm-title">Evaluation</h2><p class="card-pm-subtitle">Tick the KPIs and goals to score. KPIs score from actual vs target; goals are rated 1–5.</p></div></div>
                <div class="card-pm-body">
                    <div class="table-wrap mb-3">
                        <table class="table table-pm">
                            <thead><tr><th>Include</th><th>Item</th><th class="text-end">Target</th><th style="width:150px;">Actual / rating</th><th style="width:100px;">Weight</th><th>Comment</th></tr></thead>
                            <tbody>
                            @for (var i = 0; i < Model.Candidates.Count; i++)
                            {
                                var c = Model.Candidates[i];
                                var existing = Model.Scores.FirstOrDefault(s => s.Source == c.Source && (c.Source == ReviewScoreSource.Kpi ? s.KpiId == c.Id : s.GoalId == c.Id));
                                var manual = c.Source == ReviewScoreSource.Goal || c.Method == KpiScoringMethod.ManualRating;
                                <tr>
                                    <td>
                                        <input type="hidden" name="Scores[@i].Source" value="@c.Source" />
                                        <input type="hidden" name="Scores[@i].ItemId" value="@c.Id" />
                                        <input class="form-check-input" type="checkbox" name="Scores[@i].Include" value="true" checked="@(existing is not null || Model.Scores.Count == 0)" aria-label="Include @c.Name" />
                                    </td>
                                    <td class="text-wrap-cell"><span class="fw-semibold">@c.Name</span><div class="person-meta">@(c.Source == ReviewScoreSource.Kpi ? $"KPI · {Ui.Humanize(c.Method)}" : $"Goal · {c.GoalProgress}% complete")</div></td>
                                    <td class="text-end">@(c.Target is decimal t && !manual ? $"{Ui.Number(t, t % 1 == 0 ? 0 : 2)} {c.Unit}" : "—")</td>
                                    <td>
                                        @if (manual)
                                        {
                                            <input name="Scores[@i].ManualScore" type="number" step="0.5" min="1" max="5" value="@(existing?.Score)" class="form-control form-control-sm" placeholder="1–5" />
                                        }
                                        else
                                        {
                                            <input name="Scores[@i].ActualValue" type="number" step="0.01" value="@(existing?.ActualValue)" class="form-control form-control-sm" placeholder="Actual" />
                                        }
                                    </td>
                                    <td><input name="Scores[@i].Weight" type="number" step="0.5" min="0" value="@((existing?.Weight ?? c.Weight).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" class="form-control form-control-sm" /></td>
                                    <td><input name="Scores[@i].Comments" value="@existing?.Comments" class="form-control form-control-sm" maxlength="2000" /></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Candidates.Count == 0)
                    {
                        <div class="alert alert-warning small">No KPIs or goals apply to this employee. Add KPIs for the department or set goals first.</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="strengths">Strengths</label><textarea id="strengths" name="Strengths" rows="3" class="form-control">@Model.Strengths</textarea></div>
                        <div class="col-md-6"><label class="form-label" for="areas">Areas for improvement</label><textarea id="areas" name="AreasForImprovement" rows="3" class="form-control">@Model.AreasForImprovement</textarea></div>
                    </div>
                </div>
                <div class="card-pm-footer d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-outline-secondary">Save scores</button>
                    @if (r.Status == ReviewStatus.PendingManagerEvaluation)
                    {
                        <button type="submit" name="Complete" value="true" class="btn btn-primary">Complete evaluation</button>
                    }
                </div>
            </form>
        }
        else if (Model.Scores.Count > 0)
        {
            <div class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Scores</h2></div>
                <div class="card-pm-body">
                    <div class="table-wrap">
                        <table class="table table-pm">
                            <thead><tr><th>Item</th><th class="text-end">Target</th><th class="text-end">Actual</th><th class="text-end">Weight</th><th class="text-end">Score</th><th>Comment</th></tr></thead>
                            <tbody>
                            @foreach (var s in Model.Scores)
                            {
                                <tr>
                                    <td class="text-wrap-cell fw-semibold">@s.Name<div class="person-meta fw-normal">@s.Source</div></td>
                                    <td class="text-end">@(s.TargetValue?.ToString("#,##0.##") ?? "—")</td>
                                    <td class="text-end">@(s.ActualValue?.ToString("#,##0.##") ?? "—")</td>
                                    <td class="text-end">@s.Weight.ToString("0.##")</td>
                                    <td class="text-end fw-semibold">@s.Score.ToString("0.00")</td>
                                    <td class="text-wrap-cell text-muted">@s.Comments</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="card-pm mb-4">
            <div class="card-pm-header"><h2 class="card-pm-title">Assessment</h2></div>
            <div class="card-pm-body row g-4">
                <div class="col-md-6"><div class="breakdown-section mt-0">Strengths</div><p class="mb-0" style="white-space:pre-line;">@Text(Model.Strengths)</p></div>
                <div class="col-md-6"><div class="breakdown-section mt-0">Areas for improvement</div><p class="mb-0" style="white-space:pre-line;">@Text(Model.AreasForImprovement)</p></div>
                <div class="col-md-6"><div class="breakdown-section mt-0">Self-assessment</div><p class="mb-0" style="white-space:pre-line;">@Text(Model.SelfAssessment)</p></div>
                <div class="col-md-6"><div class="breakdown-section mt-0">Manager feedback</div><p class="mb-0" style="white-space:pre-line;">@Text(Model.ManagerComments)</p></div>
                <div class="col-md-6"><div class="breakdown-section mt-0">Development recommendations</div><p class="mb-0" style="white-space:pre-line;">@Text(Model.DevelopmentRecommendations)</p></div>
                <div class="col-md-6"><div class="breakdown-section mt-0">Employee comments</div><p class="mb-0" style="white-space:pre-line;">@Text(Model.EmployeeComments)</p></div>
                @if (Model.HrComments is not null) { <div class="col-12"><div class="breakdown-section mt-0">HR comments</div><p class="mb-0">@Model.HrComments</p></div> }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        @if (Model.IsEmployee && r.Status == ReviewStatus.PendingSelfAssessment)
        {
            <form method="post" asp-action="SelfAssess" asp-route-id="@r.Id" class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Your self-assessment</h2></div>
                <div class="card-pm-body"><textarea name="selfAssessment" rows="8" class="form-control" required maxlength="5000" placeholder="Achievements, challenges and what you'd like to develop next."></textarea></div>
                <div class="card-pm-footer text-end"><button type="submit" class="btn btn-primary">Submit self-assessment</button></div>
            </form>
        }
        @if (Model.IsReviewer && r.Status == ReviewStatus.PendingManagerFeedback)
        {
            <form method="post" asp-action="Feedback" asp-route-id="@r.Id" class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Manager feedback</h2></div>
                <div class="card-pm-body d-grid gap-3">
                    <div><label class="form-label" for="mc">Feedback for the employee</label><textarea id="mc" name="ManagerComments" rows="5" class="form-control" required>@Model.ManagerComments</textarea></div>
                    <div><label class="form-label" for="dr">Development recommendations</label><textarea id="dr" name="DevelopmentRecommendations" rows="3" class="form-control">@Model.DevelopmentRecommendations</textarea></div>
                </div>
                <div class="card-pm-footer text-end"><button type="submit" class="btn btn-primary">Share feedback</button></div>
            </form>
        }
        @if (Model.IsEmployee && r.Status == ReviewStatus.PendingAcknowledgement)
        {
            <form method="post" asp-action="Acknowledge" asp-route-id="@r.Id" class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Acknowledge feedback</h2></div>
                <div class="card-pm-body"><label class="form-label" for="ec">Your comments (optional)</label><textarea id="ec" name="comments" rows="4" class="form-control"></textarea></div>
                <div class="card-pm-footer text-end"><button type="submit" class="btn btn-primary">Acknowledge</button></div>
            </form>
        }
        @if (Model.IsHr && r.Status == ReviewStatus.PendingHrFinalization)
        {
            <form method="post" asp-action="Finalize" asp-route-id="@r.Id" class="card-pm mb-4" data-confirm="Finalize this review? It becomes part of the employee's permanent record." data-confirm-button="Finalize">
                <div class="card-pm-header"><h2 class="card-pm-title">Finalize review</h2></div>
                <div class="card-pm-body"><label class="form-label" for="hc">HR comments (optional)</label><textarea id="hc" name="hrComments" rows="3" class="form-control"></textarea>
                    <p class="small text-muted mt-2 mb-0">Scores never change salaries automatically. Any pay change must be proposed and approved separately.</p></div>
                <div class="card-pm-footer text-end"><button type="submit" class="btn btn-primary">Finalize</button></div>
            </form>
        }

        <div class="card-pm mb-4">
            <div class="card-pm-header">
                <h2 class="card-pm-title">Development plans</h2>
                @if (Model.IsReviewer)
                {
                    <a asp-controller="Goals" asp-action="Plan" asp-route-employeeId="@r.EmployeeId" asp-route-reviewId="@r.Id" class="small fw-semibold">Add plan</a>
                }
            </div>
            <div class="card-pm-body">
                @if (Model.DevelopmentPlans.Count == 0)
                {
                    <p class="text-muted mb-0">No development plans.</p>
                }
                else
                {
                    <ul class="list-clean d-grid gap-3">
                        @foreach (var p in Model.DevelopmentPlans)
                        {
                            <li><span class="fw-semibold">@p.Title</span><span class="d-block small text-muted">@Ui.Humanize(p.Type) · @p.Progress% · target @Ui.Date(p.TargetDate)</span></li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card-pm">
            <div class="card-pm-header"><h2 class="card-pm-title">Timeline</h2></div>
            <div class="card-pm-body">
                <dl class="detail-list small">
                    <dt>Manager evaluation</dt><dd>@Ui.DateTime(Model.ManagerEvaluatedAt)</dd>
                    <dt>Self-assessment</dt><dd>@Ui.DateTime(Model.SelfAssessedAt)</dd>
                    <dt>Feedback given</dt><dd>@Ui.DateTime(Model.FeedbackGivenAt)</dd>
                    <dt>Acknowledged</dt><dd>@Ui.DateTime(Model.AcknowledgedAt)</dd>
                    <dt>Finalized</dt><dd>@Ui.DateTime(Model.FinalizedAt)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
