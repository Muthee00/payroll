@using PayMaster.Application.Common.Models
@using PayMaster.Application.Notifications
@model PagedResult<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    var unreadOnly = (bool)(ViewBag.UnreadOnly ?? false);
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Notifications</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <h1 class="page-title">Notifications</h1>
        <p class="page-subtitle">Payroll approvals, payslips and performance activity that needs your attention.</p>
    </div>
    <div class="page-actions">
        <form method="post" asp-action="MarkAllRead">
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-check2-all me-1"></i> Mark all read</button>
        </form>
    </div>
</div>

<div class="card-pm">
    <div class="card-pm-header">
        <ul class="nav nav-tabs-pm">
            <li class="nav-item"><a class="nav-link @(!unreadOnly ? "active" : null)" asp-action="Index">All</a></li>
            <li class="nav-item"><a class="nav-link @(unreadOnly ? "active" : null)" asp-action="Index" asp-route-unread="true">Unread</a></li>
        </ul>
    </div>
    <div class="card-pm-body">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><i class="bi bi-bell"></i></span>
                <h3>No notifications</h3>
                <p>You're all caught up.</p>
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var n in Model.Items)
                {
                    var icon = n.Type switch
                    {
                        NotificationType.Success => "bi-check-circle text-success",
                        NotificationType.Warning => "bi-exclamation-triangle text-warning",
                        NotificationType.Error => "bi-x-circle text-danger",
                        _ => "bi-info-circle text-primary"
                    };
                    <form method="post" asp-action="Open" asp-route-id="@n.Id" data-no-busy>
                        <button type="submit" class="list-group-item list-group-item-action d-flex gap-3 py-3 text-start @(n.IsRead ? "" : "bg-light")">
                            <i class="bi @icon fs-5"></i>
                            <span class="flex-grow-1">
                                <span class="d-flex justify-content-between gap-2">
                                    <span class="fw-semibold">@n.Title</span>
                                    <span class="text-muted small">@Ui.DateTime(n.CreatedAt)</span>
                                </span>
                                <span class="d-block text-muted small">@n.Message</span>
                            </span>
                        </button>
                    </form>
                }
            </div>
            <partial name="_Pager" model='PagerModel.From(Model, "notifications")' />
        }
    </div>
</div>
