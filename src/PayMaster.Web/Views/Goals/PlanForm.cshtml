@model PayMaster.Web.ViewModels.Performance.PlanFormViewModel
@{
    ViewData["Title"] = "New development plan";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="development">Development</a></li>
        <li class="breadcrumb-item active" aria-current="page">New plan</li>
    </ol>
</nav>
<div class="page-header"><div><h1 class="page-title">New development plan</h1><p class="page-subtitle">Training, development and improvement plans, career objectives and skills assessments.</p></div></div>
<div class="row">
    <div class="col-lg-8">
        <div class="card-pm">
            <form method="post" asp-action="Plan" novalidate>
                <input type="hidden" asp-for="Input.ReviewId" />
                <div class="card-pm-body row g-3">
                    <div class="col-12" asp-validation-summary="All"></div>
                    <div class="col-md-6">
                        <label asp-for="Input.EmployeeId" class="form-label">Employee *</label>
                        <select asp-for="Input.EmployeeId" class="form-select">
                            <option value="0">Select employee…</option>
                            @foreach (var e in Model.Employees) { <option value="@e.Id">@e.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6"><label asp-for="Input.Type" class="form-label">Type</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<DevelopmentPlanType>()" class="form-select"></select></div>
                    <div class="col-12"><label asp-for="Input.Title" class="form-label">Title *</label><input asp-for="Input.Title" class="form-control" placeholder="e.g. Advanced negotiation course" /></div>
                    <div class="col-md-6"><label asp-for="Input.StartDate" class="form-label">Start</label><input asp-for="Input.StartDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Input.TargetDate" class="form-label">Target</label><input asp-for="Input.TargetDate" type="date" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Input.Skills" class="form-label">Skills</label><input asp-for="Input.Skills" class="form-control" placeholder="Comma-separated skills" /></div>
                    <div class="col-12"><label asp-for="Input.Description" class="form-label">Description</label><textarea asp-for="Input.Description" rows="3" class="form-control"></textarea></div>
                </div>
                <div class="card-pm-footer d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-tab="development" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save plan</button>
                </div>
            </form>
        </div>
    </div>
</div>
