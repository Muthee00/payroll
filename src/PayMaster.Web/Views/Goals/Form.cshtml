@model PayMaster.Web.ViewModels.Performance.GoalFormViewModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "New goal" : "Edit goal";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Goals</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>
<div class="page-header"><div><h1 class="page-title">@ViewData["Title"]</h1><p class="page-subtitle">The employee is notified and can update progress with supporting evidence.</p></div></div>
<div class="row">
    <div class="col-lg-8">
        <div class="card-pm">
            <form method="post" asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@Model.Id" novalidate>
                <div class="card-pm-body row g-3">
                    <div class="col-12" asp-validation-summary="All"></div>
                    <div class="col-12"><label asp-for="Input.Title" class="form-label">Goal title *</label><input asp-for="Input.Title" class="form-control" /></div>
                    <div class="col-md-6">
                        <label asp-for="Input.EmployeeId" class="form-label">Employee *</label>
                        <select asp-for="Input.EmployeeId" class="form-select" disabled="@(!isCreate)">
                            <option value="0">Select employee…</option>
                            @foreach (var e in Model.Employees) { <option value="@e.Id">@e.Name@(e.Extra is null ? "" : $" — {e.Extra}")</option> }
                        </select>
                        @if (!isCreate) { <input type="hidden" asp-for="Input.EmployeeId" /> }
                    </div>
                    <div class="col-md-3"><label asp-for="Input.Category" class="form-label">Category</label><select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<GoalCategory>()" class="form-select"></select></div>
                    <div class="col-md-3"><label asp-for="Input.Priority" class="form-label">Priority</label><select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<GoalPriority>()" class="form-select"></select></div>
                    <div class="col-md-6"><label asp-for="Input.StartDate" class="form-label">Start date *</label><input asp-for="Input.StartDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Input.TargetDate" class="form-label">Target completion *</label><input asp-for="Input.TargetDate" type="date" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Input.Description" class="form-label">Description</label><textarea asp-for="Input.Description" rows="3" class="form-control"></textarea></div>
                    <div class="col-12"><label asp-for="Input.SuccessCriteria" class="form-label">Success criteria</label><textarea asp-for="Input.SuccessCriteria" rows="3" class="form-control" placeholder="How will we know this goal is achieved?"></textarea></div>
                </div>
                <div class="card-pm-footer d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">@(isCreate ? "Create goal" : "Save goal")</button>
                </div>
            </form>
        </div>
    </div>
</div>
