@model PayMaster.Web.ViewModels.Performance.KpiFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "New KPI" : "Edit KPI";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="kpis">KPIs</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>
<div class="page-header"><div><h1 class="page-title">@ViewData["Title"]</h1><p class="page-subtitle">KPIs apply in reviews to employees in the selected department and job title (or everyone when left blank).</p></div></div>
<div class="row">
    <div class="col-lg-8">
        <div class="card-pm">
            <form method="post" asp-action="Kpi" asp-route-id="@Model.Id" novalidate>
                <div class="card-pm-body row g-3">
                    <div class="col-12" asp-validation-summary="All"></div>
                    <div class="col-md-8"><label asp-for="Input.Name" class="form-label">Name *</label><input asp-for="Input.Name" class="form-control" placeholder="e.g. Monthly sales target" /></div>
                    <div class="col-md-4"><label asp-for="Input.ScoringMethod" class="form-label">Scoring</label><select asp-for="Input.ScoringMethod" asp-items="Html.GetEnumSelectList<KpiScoringMethod>()" class="form-select"></select></div>
                    <div class="col-md-4"><label asp-for="Input.TargetValue" class="form-label">Target</label><input asp-for="Input.TargetValue" type="number" step="0.01" min="0" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Input.MeasurementUnit" class="form-label">Unit</label><input asp-for="Input.MeasurementUnit" class="form-control" list="units" /><datalist id="units"><option value="%"></option><option value="KES"></option><option value="hours"></option><option value="tickets"></option><option value="score"></option><option value="days"></option></datalist></div>
                    <div class="col-md-4"><label asp-for="Input.Weight" class="form-label">Weight</label><input asp-for="Input.Weight" type="number" step="0.5" min="0" max="100" class="form-control" /></div>
                    <div class="col-md-6">
                        <label asp-for="Input.DepartmentId" class="form-label">Department</label>
                        <select asp-for="Input.DepartmentId" class="form-select" id="kpiDepartment">
                            <option value="">All departments</option>
                            @foreach (var d in Model.Lookups.Departments) { <option value="@d.Id">@d.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.PositionId" class="form-label">Job title</label>
                        <select asp-for="Input.PositionId" class="form-select" data-filter-parent="#kpiDepartment">
                            <option value="">All job titles</option>
                            @foreach (var p in Model.Lookups.Positions) { <option value="@p.Id" data-parent="@p.Extra">@p.Name</option> }
                        </select>
                    </div>
                    <div class="col-12"><label asp-for="Input.Description" class="form-label">Description</label><textarea asp-for="Input.Description" rows="2" class="form-control"></textarea></div>
                </div>
                <div class="card-pm-footer d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-tab="kpis" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save KPI</button>
                </div>
            </form>
        </div>
    </div>
</div>
