@model PayMaster.Web.ViewModels.Payslips.PayslipIndexViewModel
@{
    ViewData["Title"] = Model.OwnOnly ? "My payslips" : "Payslips";
    var q = Model.Query;
    var years = Enumerable.Range(DateTime.UtcNow.Year - 4, 5).Reverse();
    var latest = Model.OwnOnly ? Model.Result.Items.FirstOrDefault() : null;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle">@(Model.OwnOnly ? "Download, print or email your payslips. Only you can see them." : "Payslips issued from finalized payrolls.")</p>
    </div>
    @if (Model.CanViewAll)
    {
        <div class="page-actions">
            <ul class="nav nav-tabs-pm">
                <li class="nav-item"><a class="nav-link @(!Model.OwnOnly ? "active" : null)" asp-action="Index">All payslips</a></li>
                <li class="nav-item"><a class="nav-link @(Model.OwnOnly ? "active" : null)" asp-action="Index" asp-route-mine="true">My payslips</a></li>
            </ul>
        </div>
    }
</div>

@if (latest is not null)
{
    <div class="card-pm mb-4">
        <div class="card-pm-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="small-caps">Latest payslip · @latest.PeriodName</div>
                <div class="d-flex flex-wrap gap-4 mt-2">
                    <div><div class="text-muted small">Gross pay</div><div class="fw-bold fs-5 money">@Ui.Money(latest.GrossEarnings)</div></div>
                    <div><div class="text-muted small">Deductions</div><div class="fw-bold fs-5 money">@Ui.Money(latest.TotalDeductions)</div></div>
                    <div><div class="text-muted small">Net pay</div><div class="fw-bold fs-4 money text-success">@Ui.Money(latest.NetPay)</div></div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Details" asp-route-id="@latest.Id" class="btn btn-outline-secondary"><i class="bi bi-eye me-1"></i> View</a>
                <a asp-action="Pdf" asp-route-id="@latest.Id" class="btn btn-primary"><i class="bi bi-download me-1"></i> Download PDF</a>
            </div>
        </div>
    </div>
}

<div class="card-pm">
    <div class="card-pm-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="mine" value="@(Model.OwnOnly && Model.CanViewAll ? "true" : "")" />
            @if (!Model.OwnOnly)
            {
                <div class="col-md-4">
                    <label class="form-label" for="search">Search</label>
                    <div class="input-icon"><i class="bi bi-search"></i><input id="search" name="search" value="@q.Search" class="form-control" placeholder="Employee, number or payslip no." /></div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="departmentId">Department</label>
                    <select id="departmentId" name="departmentId" class="form-select" data-autosubmit>
                        <option value="">All departments</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Id" selected="@(q.DepartmentId == d.Id)">@d.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label" for="year">Year</label>
                <select id="year" name="year" class="form-select" data-autosubmit>
                    <option value="">All years</option>
                    @foreach (var y in years)
                    {
                        <option value="@y" selected="@(q.Year == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="month">Month</label>
                <select id="month" name="month" class="form-select" data-autosubmit>
                    <option value="">All months</option>
                    @for (var mth = 1; mth <= 12; mth++)
                    {
                        <option value="@mth" selected="@(q.Month == mth)">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(mth)</option>
                    }
                </select>
            </div>
            @if (!Model.OwnOnly)
            {
                <div class="col-md-1"><button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-funnel"></i></button></div>
            }
        </form>

        @if (Model.Result.Items.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon"><i class="bi bi-receipt"></i></span>
                <h3>No payslips yet</h3>
                <p>Payslips appear here once a payroll is finalized.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-pm">
                    <thead>
                    <tr>
                        <th>Period</th>
                        @if (!Model.OwnOnly) { <th>Employee</th><th>Department</th> }
                        <th>Payslip no.</th><th>Paid on</th><th class="text-end">Gross</th><th class="text-end">Deductions</th><th class="text-end">Net pay</th>
                        @if (!Model.OwnOnly) { <th>Email</th> }
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Result.Items)
                    {
                        <tr data-href="@Url.Action("Details", new { id = p.Id })" style="cursor:pointer;">
                            <td class="fw-semibold">@p.PeriodName @if (p.RunStatus == PayrollRunStatus.Reversed) { <span class="status status-danger ms-1">Reversed</span> }</td>
                            @if (!Model.OwnOnly)
                            {
                                <td>@p.EmployeeName<div class="person-meta">@p.EmployeeNumber</div></td>
                                <td>@p.DepartmentName</td>
                            }
                            <td class="text-muted">@p.PayslipNumber</td>
                            <td>@Ui.Date(p.PaymentDate)</td>
                            <td class="text-end money">@Ui.Money(p.GrossEarnings)</td>
                            <td class="text-end money">@Ui.Money(p.TotalDeductions)</td>
                            <td class="text-end money fw-semibold">@Ui.Money(p.NetPay)</td>
                            @if (!Model.OwnOnly)
                            {
                                <td>
                                    <span class="status @(p.EmailStatus switch { PayslipEmailStatus.Sent => "status-success", PayslipEmailStatus.Failed => "status-danger", PayslipEmailStatus.Queued => "status-info", _ => "status-neutral" })">@Ui.Humanize(p.EmailStatus)</span>
                                </td>
                            }
                            <td class="text-end">
                                <a asp-action="Pdf" asp-route-id="@p.Id" class="btn btn-light btn-icon btn-sm border-0" aria-label="Download PDF" title="Download PDF"><i class="bi bi-download"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_Pager" model='PagerModel.From(Model.Result, "payslips")' />
        }
    </div>
</div>
