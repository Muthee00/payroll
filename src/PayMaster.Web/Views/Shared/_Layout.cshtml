<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PayMaster</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="app-shell">
    <partial name="_Sidebar" />
    <div class="sidebar-backdrop"></div>

    <div class="main">
        <partial name="_Topbar" />

        <main class="content" id="main-content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>&copy; @DateTime.UtcNow.Year PayMaster. All rights reserved.</span>
            <span>Payroll &amp; HR for Kenyan businesses</span>
        </footer>
    </div>
</div>

<partial name="_Toasts" />
<partial name="_ConfirmModal" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
