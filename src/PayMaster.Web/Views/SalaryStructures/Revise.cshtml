@model PayMaster.Web.ViewModels.Salary.StructureRevisionViewModel
@{
    ViewData["Title"] = $"Revise {Model.Structure.Name}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Salary Structures</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Structure.Id">@Model.Structure.Code</a></li>
        <li class="breadcrumb-item active" aria-current="page">Revise</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <h1 class="page-title">Revise salaries on @Model.Structure.Name</h1>
        <p class="page-subtitle">Proposes a new salary for each of the @Model.Structure.Employees.Count employees on this structure. Each change needs approval and only applies from the effective date.</p>
    </div>
</div>
<div class="row">
    <div class="col-lg-6">
        <div class="card-pm">
            <div class="card-pm-body">
                <form method="post" asp-action="Revise" asp-route-id="@Model.Structure.Id" class="d-grid gap-3" novalidate>
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <div>
                        <label asp-for="Input.IncreasePercent" class="form-label">Change to basic salary (%)</label>
                        <div class="input-group">
                            <input asp-for="Input.IncreasePercent" type="number" step="0.01" class="form-control" placeholder="5" />
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="form-text">Allowances defined as a percentage of basic scale automatically; fixed allowances follow the structure.</div>
                    </div>
                    <div>
                        <label asp-for="Input.EffectiveFrom" class="form-label">Effective from</label>
                        <input asp-for="Input.EffectiveFrom" type="date" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Input.Reason" class="form-label">Reason</label>
                        <input asp-for="Input.Reason" class="form-control" placeholder="Annual cost-of-living adjustment 2027" />
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Details" asp-route-id="@Model.Structure.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Propose revisions</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
