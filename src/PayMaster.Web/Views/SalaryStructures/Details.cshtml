@model PayMaster.Application.Salary.SalaryStructureDetails
@{
    ViewData["Title"] = Model.Name;
    var canManage = User.Can(Permissions.Salary.ManageStructures);
    var canRevise = User.Can(Permissions.Salary.ManageEmployeeSalary);
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Salary Structures</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title mb-0">@Model.Name</h1>
            <span class="status @(Model.Status == SalaryStructureStatus.Active ? "status-success" : Model.Status == SalaryStructureStatus.Draft ? "status-warning" : "status-neutral")">@Model.Status</span>
        </div>
        <p class="page-subtitle mt-1">@Model.Code · @(Model.DepartmentName ?? "All departments")@(Model.PositionTitle is null ? "" : $" · {Model.PositionTitle}") · effective @Ui.Date(Model.EffectiveFrom)</p>
    </div>
    <div class="page-actions">
        @if (canRevise && Model.Status == SalaryStructureStatus.Active && Model.Employees.Count > 0)
        {
            <a asp-action="Revise" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-graph-up-arrow me-1"></i> Revise salaries</a>
        }
        @if (canManage && Model.Status != SalaryStructureStatus.Archived)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Edit</a>
            @if (Model.Status == SalaryStructureStatus.Draft)
            {
                <form method="post" asp-action="SetStatus" asp-route-id="@Model.Id" asp-route-status="Active">
                    <button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Activate</button>
                </form>
            }
            else
            {
                <form method="post" asp-action="SetStatus" asp-route-id="@Model.Id" asp-route-status="Archived"
                      data-confirm="Archived structures can no longer be assigned. Employees already on it keep their current salaries." data-confirm-title="Archive structure?" data-confirm-button="Archive" data-confirm-variant="warning">
                    <button class="btn btn-outline-secondary"><i class="bi bi-archive me-1"></i> Archive</button>
                </form>
            }
        }
    </div>
</div>

<div class="row gap-row">
    <div class="col-lg-5">
        <div class="card-pm h-100">
            <div class="card-pm-header">
                <div>
                    <h2 class="card-pm-title">Pay breakdown</h2>
                    <p class="card-pm-subtitle">
                        @if (Model.GradeName is not null)
                        {
                            <text>@Model.GradeName band: @Ui.MoneyShort(Model.GradeMin ?? 0) – @Ui.MoneyShort(Model.GradeMax ?? 0)</text>
                        }
                        else
                        {
                            <text>No grade assigned</text>
                        }
                    </p>
                </div>
            </div>
            <div class="card-pm-body">
                <table class="w-100 breakdown-table">
                    <tr><td>Basic salary</td><td class="text-end money">@Ui.Money(Model.BasicSalary)</td></tr>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.ComponentName @if (line.AmountType == AmountType.PercentageOfBasic) { <span class="text-muted small">(@line.Amount.ToString("0.##")% of basic)</span> }</td>
                            <td class="text-end money">@Ui.Money(line.ResolvedAmount)</td>
                        </tr>
                    }
                    <tr class="total"><td>Gross monthly salary</td><td class="text-end money">@Ui.Money(Model.GrossSalary)</td></tr>
                </table>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted small mt-3 mb-0">@Model.Description</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card-pm h-100">
            <div class="card-pm-header">
                <div>
                    <h2 class="card-pm-title">Employees on this structure <span class="text-muted fw-normal">(@Model.Employees.Count)</span></h2>
                    <p class="card-pm-subtitle">Their approved salaries. Editing the structure does not change these until a revision is approved.</p>
                </div>
            </div>
            <div class="card-pm-body">
                @if (Model.Employees.Count == 0)
                {
                    <p class="text-muted mb-0">No employees are currently paid on this structure.</p>
                }
                else
                {
                    <div class="table-wrap" style="max-height: 420px;">
                        <table class="table table-pm">
                            <thead><tr><th>Employee</th><th>Department</th><th class="text-end">Basic</th><th class="text-end">Gross</th><th>Since</th></tr></thead>
                            <tbody>
                            @foreach (var e in Model.Employees)
                            {
                                <tr>
                                    <td><a asp-controller="Employees" asp-action="Details" asp-route-id="@e.EmployeeId" class="row-link">@e.Name</a><div class="person-meta">@e.EmployeeNumber</div></td>
                                    <td>@e.DepartmentName</td>
                                    <td class="text-end money">@Ui.MoneyShort(e.BasicSalary)</td>
                                    <td class="text-end money">@Ui.MoneyShort(e.GrossSalary)</td>
                                    <td>@Ui.Date(e.EffectiveFrom)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
