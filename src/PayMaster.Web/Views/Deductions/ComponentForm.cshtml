@model PayMaster.Web.ViewModels.Salary.SalaryComponentFormViewModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "New pay component" : $"Edit {Model.Input.Name}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="components">Pay components</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isCreate ? "New" : "Edit")</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle">The tax treatment controls how the component affects PAYE. Confirm treatment with KRA guidance for non-standard items.</p>
    </div>
</div>
<div class="row">
    <div class="col-lg-7">
        <div class="card-pm">
            <form method="post" asp-action="@(isCreate ? "CreateComponent" : "EditComponent")" asp-route-id="@Model.Id" novalidate>
                <div class="card-pm-body row g-3">
                    <div class="col-12" asp-validation-summary="All"></div>
                    <div class="col-md-4">
                        <label asp-for="Input.Code" class="form-label">Code *</label>
                        <input asp-for="Input.Code" class="form-control text-uppercase" placeholder="NIGHT_ALLOWANCE" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Input.Name" class="form-label">Name *</label>
                        <input asp-for="Input.Name" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Type" class="form-label">Type</label>
                        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<ComponentType>()" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Category" class="form-label">Category</label>
                        <select asp-for="Input.Category" class="form-select">
                            @foreach (var c in Enum.GetValues<ComponentCategory>())
                            {
                                <option value="@((int)c)" selected="@(Model.Input.Category == c)">@((int)c < 20 ? "Earning" : "Deduction") — @Ui.Humanize(c)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.TaxTreatment" class="form-label">Tax treatment</label>
                        <select asp-for="Input.TaxTreatment" asp-items="Html.GetEnumSelectList<TaxTreatment>()" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.DisplayOrder" class="form-label">Display order</label>
                        <input asp-for="Input.DisplayOrder" type="number" class="form-control" />
                    </div>
                    <div class="col-md-8 d-flex flex-column justify-content-end gap-2">
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsRecurring" class="form-check-input" role="switch" />
                            <label asp-for="Input.IsRecurring" class="form-check-label">Recurring every month (allowance / standing deduction)</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsPensionable" class="form-check-input" role="switch" />
                            <label asp-for="Input.IsPensionable" class="form-check-label">Counts towards NSSF pensionable pay (earnings only)</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label">Description</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light border small mb-0">
                            <strong>Tax treatments:</strong> Taxable / Non-taxable (earnings) · Post-tax (loans, HELB, SACCO) · Allowable deduction (registered pension, capped) ·
                            Insurance relief (qualifying premiums) · Reduces gross (unpaid leave / absenteeism).
                        </div>
                    </div>
                </div>
                <div class="card-pm-footer d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-tab="components" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save component</button>
                </div>
            </form>
        </div>
    </div>
</div>
