@model PayMaster.Web.ViewModels.Salary.PayrollInputFormViewModel
@{
    var isCreate = Model.Id is null;
    ViewData["Title"] = isCreate ? "Add payroll item" : "Edit payroll item";
    var periodKey = $"{Model.Input.Year:D4}-{Model.Input.Month:D2}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="inputs" asp-route-period="@periodKey">Period items</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isCreate ? "Add" : "Edit")</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle">One-off earnings or deductions for a single payroll month (overtime, bonus, commission, advance, absenteeism).</p>
    </div>
</div>
<div class="row">
    <div class="col-lg-7">
        <div class="card-pm">
            <form method="post" asp-action="@(isCreate ? "CreateInput" : "EditInput")" asp-route-id="@Model.Id" novalidate>
                <div class="card-pm-body row g-3">
                    <div class="col-12" asp-validation-summary="ModelOnly"></div>
                    <div class="col-md-8">
                        <label asp-for="Input.EmployeeId" class="form-label">Employee *</label>
                        <select asp-for="Input.EmployeeId" class="form-select">
                            <option value="0">Select employee…</option>
                            @foreach (var e in Model.Employees)
                            {
                                <option value="@e.Id">@e.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Input.EmployeeId" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="periodSelect">Period *</label>
                        <select id="periodSelect" class="form-select" name="period" data-period-target>
                            @foreach (var p in Model.Periods)
                            {
                                <option value="@p.Key" selected="@(p.Key == periodKey)">@p.Name</option>
                            }
                        </select>
                        <input type="hidden" asp-for="Input.Year" id="inputYear" />
                        <input type="hidden" asp-for="Input.Month" id="inputMonth" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.SalaryComponentId" class="form-label">Item *</label>
                        <select asp-for="Input.SalaryComponentId" class="form-select">
                            <option value="0">Select item…</option>
                            <optgroup label="Earnings">
                                @foreach (var c in Model.ItemTypes.Where(c => c.Type == ComponentType.Earning))
                                {
                                    <option value="@c.Id">@c.Name (@Ui.Humanize(c.TaxTreatment))</option>
                                }
                            </optgroup>
                            <optgroup label="Deductions">
                                @foreach (var c in Model.ItemTypes.Where(c => c.Type == ComponentType.Deduction))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </optgroup>
                        </select>
                        <span asp-validation-for="Input.SalaryComponentId" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Quantity" class="form-label">Quantity</label>
                        <input asp-for="Input.Quantity" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 10 hours" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Rate" class="form-label">Rate (KES)</label>
                        <input asp-for="Input.Rate" type="number" step="0.01" min="0" class="form-control" placeholder="per unit" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Amount" class="form-label">Amount (KES)</label>
                        <input asp-for="Input.Amount" type="number" step="0.01" min="0" class="form-control" placeholder="or quantity × rate" />
                        <span asp-validation-for="Input.Amount" class="field-validation-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label">Description</label>
                        <input asp-for="Input.Description" class="form-control" placeholder="e.g. Weekend deployment support" />
                    </div>
                </div>
                <div class="card-pm-footer d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-tab="inputs" asp-route-period="@periodKey" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">@(isCreate ? "Add item" : "Save changes")</button>
                </div>
            </form>
        </div>
    </div>
</div>
