@using PayMaster.Application.Employees
@model EmployeeDetailsDto
@{
    ViewData["Title"] = Model.FullName;
    var canManage = User.Can(Permissions.Employees.Manage);
    var canChangeStatus = User.Can(Permissions.Employees.Terminate);
    var isTerminated = Model.Status == EmploymentStatus.Terminated;
    string Value(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        @if (User.Can(Permissions.Employees.View))
        {
            <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.EmployeeNumber</li>
    </ol>
</nav>

<div class="card-pm mb-4">
    <div class="card-pm-body d-flex flex-wrap align-items-center gap-3">
        <span class="avatar avatar-lg @Ui.AvatarClass(Model.EmployeeNumber)">@Ui.Initials(Model.FullName)</span>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="page-title mb-0">@Model.FullName</h1>
                <span class="status @Ui.StatusCss(Model.Status)">@Ui.Humanize(Model.Status)</span>
            </div>
            <div class="text-muted mt-1">
                @(Model.JobTitle ?? "No job title") · @Model.DepartmentName · @Model.EmployeeNumber
                @if (Model.WorkEmail is not null)
                {
                    <span> · <a href="mailto:@Model.WorkEmail">@Model.WorkEmail</a></span>
                }
            </div>
        </div>
        <div class="page-actions">
            @if (canManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Edit</a>
            }
            @if ((canManage || canChangeStatus) && !isTerminated)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" type="button">Status</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (canManage && Model.Status == EmploymentStatus.Active)
                        {
                            <li>
                                <form method="post" asp-action="SetLeave" asp-route-id="@Model.Id" asp-route-onLeave="true">
                                    <button class="dropdown-item"><i class="bi bi-airplane"></i> Mark as on leave</button>
                                </form>
                            </li>
                        }
                        @if (canManage && Model.Status == EmploymentStatus.OnLeave)
                        {
                            <li>
                                <form method="post" asp-action="SetLeave" asp-route-id="@Model.Id" asp-route-onLeave="false">
                                    <button class="dropdown-item"><i class="bi bi-box-arrow-in-left"></i> Return from leave</button>
                                </form>
                            </li>
                        }
                        @if (canChangeStatus && Model.Status == EmploymentStatus.Deactivated)
                        {
                            <li>
                                <form method="post" asp-action="Reactivate" asp-route-id="@Model.Id">
                                    <button class="dropdown-item"><i class="bi bi-arrow-counterclockwise"></i> Reactivate</button>
                                </form>
                            </li>
                        }
                        @if (canChangeStatus && Model.Status != EmploymentStatus.Deactivated)
                        {
                            <li>
                                <form method="post" asp-action="Deactivate" asp-route-id="@Model.Id"
                                      data-confirm="@Model.FullName will be excluded from payroll until reactivated." data-confirm-title="Deactivate employee?"
                                      data-confirm-button="Deactivate" data-confirm-variant="warning" data-confirm-reason="true">
                                    <button class="dropdown-item"><i class="bi bi-pause-circle"></i> Deactivate</button>
                                </form>
                            </li>
                        }
                        @if (canChangeStatus)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li><button class="dropdown-item text-danger" type="button" data-bs-toggle="modal" data-bs-target="#terminateModal"><i class="bi bi-person-x text-danger"></i> Terminate…</button></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@if (isTerminated)
{
    <div class="alert alert-danger d-flex gap-2"><i class="bi bi-person-x"></i>
        <span>Terminated on <strong>@Ui.Date(Model.TerminationDate)</strong> — @Model.TerminationReason</span></div>
}
@if (Model.PendingSalary is not null && Model.CanViewSalary)
{
    <div class="alert alert-warning d-flex gap-2"><i class="bi bi-hourglass-split"></i>
        <span>A salary change to <strong>@Ui.Money(Model.PendingSalary.BasicSalary)</strong> basic from @Ui.Date(Model.PendingSalary.EffectiveFrom) is awaiting approval.</span></div>
}

<ul class="nav nav-tabs-pm mb-4" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#overview" role="tab">Overview</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#employment" role="tab">Employment</a></li>
    @if (Model.CanViewSalary)
    {
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#salary" role="tab">Salary &amp; pay</a></li>
    }
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#documents" role="tab">Documents <span class="badge text-bg-light">@Model.Documents.Count</span></a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#history" role="tab">History</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="overview" role="tabpanel">
        <div class="row gap-row">
            <div class="col-lg-6">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><h2 class="card-pm-title">Personal information</h2></div>
                    <div class="card-pm-body">
                        <dl class="detail-list">
                            <dt>Full name</dt><dd>@Model.FullName</dd>
                            <dt>Gender</dt><dd>@Model.Gender</dd>
                            <dt>Date of birth</dt><dd>@Ui.Date(Model.DateOfBirth)</dd>
                            <dt>National ID</dt><dd>@Model.NationalId</dd>
                            <dt>Physical address</dt><dd>@Value(Model.PhysicalAddress)</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><h2 class="card-pm-title">Statutory identifiers</h2></div>
                    <div class="card-pm-body">
                        <dl class="detail-list">
                            <dt>KRA PIN</dt><dd>@Value(Model.KraPin)</dd>
                            <dt>NSSF number</dt><dd>@Value(Model.NssfNumber)</dd>
                            <dt>SHA number</dt><dd>@Value(Model.ShaNumber)</dd>
                            <dt>Disability exemption</dt>
                            <dd>@(Model.HasDisabilityExemption ? $"Yes — {Model.DisabilityExemptionCertificateNumber}" : "No")</dd>
                        </dl>
                        @if (Model.KraPin is null || Model.NssfNumber is null || Model.ShaNumber is null)
                        {
                            <div class="alert alert-warning small mt-3 mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Missing statutory identifiers will be flagged during payroll validation.</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><h2 class="card-pm-title">Contact</h2></div>
                    <div class="card-pm-body">
                        <dl class="detail-list">
                            <dt>Work email</dt><dd>@Value(Model.WorkEmail)</dd>
                            <dt>Personal email</dt><dd>@Value(Model.PersonalEmail)</dd>
                            <dt>Phone</dt><dd>@Value(Model.PhoneNumber)</dd>
                            <dt>System login</dt><dd>@(Model.HasLogin ? "Yes" : "No")</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><h2 class="card-pm-title">Emergency contact</h2></div>
                    <div class="card-pm-body">
                        <dl class="detail-list">
                            <dt>Name</dt><dd>@Value(Model.EmergencyContactName)</dd>
                            <dt>Relationship</dt><dd>@Value(Model.EmergencyContactRelationship)</dd>
                            <dt>Phone</dt><dd>@Value(Model.EmergencyContactPhone)</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="employment" role="tabpanel">
        <div class="row gap-row">
            <div class="col-lg-7">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><h2 class="card-pm-title">Employment details</h2></div>
                    <div class="card-pm-body">
                        <dl class="detail-list">
                            <dt>Department</dt><dd>@Model.DepartmentName</dd>
                            <dt>Job title</dt><dd>@Value(Model.JobTitle)</dd>
                            <dt>Employment type</dt><dd>@Model.EmploymentType</dd>
                            <dt>Employment date</dt><dd>@Ui.Date(Model.EmploymentDate)</dd>
                            <dt>Contract end</dt><dd>@Ui.Date(Model.ContractEndDate)</dd>
                            <dt>Reporting manager</dt>
                            <dd>
                                @if (Model.ManagerId is int managerId)
                                {
                                    <a asp-action="Details" asp-route-id="@managerId">@Model.ManagerName</a>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </dd>
                            <dt>Work location</dt><dd>@Value(Model.WorkLocation)</dd>
                            <dt>Record created</dt><dd>@Ui.Date(Model.CreatedAt)</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card-pm h-100">
                    <div class="card-pm-header"><h2 class="card-pm-title">Direct reports <span class="text-muted fw-normal">(@Model.DirectReports.Count)</span></h2></div>
                    <div class="card-pm-body">
                        @if (Model.DirectReports.Count == 0)
                        {
                            <p class="text-muted mb-0">No direct reports.</p>
                        }
                        else
                        {
                            <ul class="list-clean d-grid gap-3">
                                @foreach (var r in Model.DirectReports)
                                {
                                    <li class="person">
                                        <span class="avatar avatar-sm @Ui.AvatarClass(r.Name)">@Ui.Initials(r.Name)</span>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@r.Id" class="person-name">@r.Name</a>
                                            <div class="person-meta">@(r.JobTitle ?? "—")</div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanViewSalary)
    {
        <div class="tab-pane fade" id="salary" role="tabpanel">
            <div class="row gap-row">
                <div class="col-lg-5">
                    <div class="card-pm h-100">
                        <div class="card-pm-header">
                            <div>
                                <h2 class="card-pm-title">Current salary</h2>
                                <p class="card-pm-subtitle">@(Model.CurrentSalary is null ? "No approved salary in force." : $"Effective {Ui.Date(Model.CurrentSalary.EffectiveFrom)}")</p>
                            </div>
                            @if (User.Can(Permissions.Salary.ManageEmployeeSalary) && !isTerminated && Model.PendingSalary is null)
                            {
                                <a asp-controller="SalaryStructures" asp-action="ChangeSalary" asp-route-employeeId="@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil-square me-1"></i> Change salary</a>
                            }
                        </div>
                        <div class="card-pm-body">
                            @if (Model.CurrentSalary is { } current)
                            {
                                <table class="w-100 breakdown-table">
                                    <tr><td>Basic salary</td><td class="text-end money">@Ui.Money(current.BasicSalary)</td></tr>
                                    @foreach (var c in current.Components)
                                    {
                                        <tr><td>@c.Name</td><td class="text-end money">@Ui.Money(c.Amount)</td></tr>
                                    }
                                    <tr class="total"><td>Gross monthly salary</td><td class="text-end money">@Ui.Money(current.GrossSalary)</td></tr>
                                </table>
                                <p class="small text-muted mt-3 mb-0">Structure: @(current.StructureName ?? "Custom") · Excludes variable pay such as overtime and bonuses.</p>
                            }
                            else
                            {
                                <div class="empty-state py-3">
                                    <span class="empty-icon"><i class="bi bi-cash"></i></span>
                                    <p class="mb-0">This employee will be flagged during payroll validation until a salary is approved.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card-pm h-100">
                        <div class="card-pm-header"><h2 class="card-pm-title">Payment details</h2></div>
                        <div class="card-pm-body">
                            <dl class="detail-list">
                                <dt>Pay frequency</dt><dd>@Model.PayFrequency</dd>
                                <dt>Payment method</dt><dd>@Ui.Humanize(Model.PaymentMethod)</dd>
                                <dt>Bank</dt><dd>@Value(Model.BankName)</dd>
                                <dt>Branch</dt><dd>@Value(Model.BankBranch)</dd>
                                <dt>Account number</dt>
                                <dd>@Value(Model.BankAccountNumber) @if (Model.BankDetailsMasked) { <i class="bi bi-lock text-muted ms-1" title="Masked: requires bank-detail permission"></i> }</dd>
                                <dt>Mobile money</dt><dd>@Value(Model.MobileMoneyNumber)</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card-pm">
                        <div class="card-pm-header">
                            <div>
                                <h2 class="card-pm-title">Recurring deductions</h2>
                                <p class="card-pm-subtitle">Loans, HELB, insurance, pension and SACCO deductions applied every payroll.</p>
                            </div>
                            @if (User.Can(Permissions.Salary.ManagePayItems) && !isTerminated)
                            {
                                <a asp-controller="Deductions" asp-action="CreateDeduction" asp-route-employeeId="@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i> Add deduction</a>
                            }
                        </div>
                        <div class="card-pm-body">
                            @if (Model.RecurringDeductions.Count == 0)
                            {
                                <p class="text-muted mb-0">No recurring deductions.</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="table table-pm">
                                        <thead><tr><th>Deduction</th><th>Reference</th><th class="text-end">Monthly</th><th class="text-end">Total</th><th class="text-end">Recovered</th><th class="text-end">Balance</th><th>Period</th><th>Status</th></tr></thead>
                                        <tbody>
                                        @foreach (var d in Model.RecurringDeductions)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@d.ComponentName</td>
                                                <td class="text-muted">@Value(d.Reference)</td>
                                                <td class="text-end money">@Ui.Money(d.MonthlyAmount)</td>
                                                <td class="text-end money">@(d.TotalAmount is decimal t ? Ui.Money(t) : "Ongoing")</td>
                                                <td class="text-end money">@Ui.Money(d.AmountRecovered)</td>
                                                <td class="text-end money">@(d.RemainingBalance is decimal r ? Ui.Money(r) : "—")</td>
                                                <td>@Ui.Date(d.StartDate) – @(d.EndDate is null ? "open" : Ui.Date(d.EndDate))</td>
                                                <td><span class="status @(d.IsActive ? "status-success" : "status-neutral")">@(d.IsActive ? "Active" : "Completed")</span></td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card-pm">
                        <div class="card-pm-header">
                            <div>
                                <h2 class="card-pm-title">Salary history</h2>
                                <p class="card-pm-subtitle">Every revision is kept; approved changes close the previous revision.</p>
                            </div>
                            @if (User.Can(Permissions.Payroll.View))
                            {
                                <a asp-controller="PayrollHistory" asp-action="Employee" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clock-history me-1"></i> Payroll history</a>
                            }
                        </div>
                        <div class="card-pm-body">
                            @if (Model.SalaryHistory.Count == 0)
                            {
                                <p class="text-muted mb-0">No salary records.</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="table table-pm">
                                        <thead><tr><th>Effective</th><th>Until</th><th class="text-end">Basic</th><th class="text-end">Gross</th><th>Structure</th><th>Reason</th><th>Status</th></tr></thead>
                                        <tbody>
                                        @foreach (var s in Model.SalaryHistory)
                                        {
                                            <tr>
                                                <td>@Ui.Date(s.EffectiveFrom)</td>
                                                <td>@(s.EffectiveTo is null ? "Present" : Ui.Date(s.EffectiveTo))</td>
                                                <td class="text-end money">@Ui.Money(s.BasicSalary)</td>
                                                <td class="text-end money">@Ui.Money(s.GrossSalary)</td>
                                                <td>@(s.StructureName ?? "Custom")</td>
                                                <td>@s.ChangeReason</td>
                                                <td><span class="status @Ui.StatusCss(s.Status)">@Ui.Humanize(s.Status)</span></td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="tab-pane fade" id="documents" role="tabpanel">
        <div class="row gap-row">
            @if (canManage)
            {
                <div class="col-lg-4">
                    <div class="card-pm">
                        <div class="card-pm-header"><h2 class="card-pm-title">Upload document</h2></div>
                        <div class="card-pm-body">
                            <form method="post" asp-action="UploadDocument" asp-route-id="@Model.Id" enctype="multipart/form-data" class="d-grid gap-3">
                                <div>
                                    <label class="form-label" for="documentType">Document type</label>
                                    <select id="documentType" name="documentType" class="form-select" asp-items="Html.GetEnumSelectList<EmployeeDocumentType>()"></select>
                                </div>
                                <div>
                                    <label class="form-label" for="docTitle">Title</label>
                                    <input id="docTitle" name="title" class="form-control" maxlength="200" placeholder="e.g. Employment contract 2026" />
                                </div>
                                <div>
                                    <label class="form-label" for="expiryDate">Expiry date (optional)</label>
                                    <input id="expiryDate" name="expiryDate" type="date" class="form-control" />
                                </div>
                                <div>
                                    <label class="form-label" for="docFile">File</label>
                                    <input id="docFile" name="file" type="file" class="form-control" accept="@EmployeeDocumentService.AcceptAttribute" required />
                                    <div class="form-text">PDF, JPG, PNG, Word or Excel up to 10 MB.</div>
                                </div>
                                <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i> Upload</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            <div class="@(canManage ? "col-lg-8" : "col-12")">
                <div class="card-pm">
                    <div class="card-pm-header"><h2 class="card-pm-title">Documents</h2></div>
                    <div class="card-pm-body">
                        @if (Model.Documents.Count == 0)
                        {
                            <div class="empty-state py-4">
                                <span class="empty-icon"><i class="bi bi-folder2-open"></i></span>
                                <h3>No documents</h3>
                                <p>Contracts, ID copies and certificates appear here.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="table table-pm">
                                    <thead><tr><th>Document</th><th>Type</th><th>Size</th><th>Expiry</th><th>Uploaded</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (var d in Model.Documents)
                                    {
                                        var expired = d.ExpiryDate is not null && d.ExpiryDate < Ui.TodayLocal();
                                        <tr>
                                            <td>
                                                <a asp-action="Document" asp-route-id="@Model.Id" asp-route-documentId="@d.Id" class="fw-semibold">
                                                    <i class="bi @(d.ContentType.Contains("pdf") ? "bi-file-earmark-pdf" : d.ContentType.StartsWith("image") ? "bi-file-earmark-image" : "bi-file-earmark") me-1"></i>@d.Title
                                                </a>
                                                <div class="person-meta">@d.OriginalFileName</div>
                                            </td>
                                            <td>@Ui.Humanize(d.DocumentType)</td>
                                            <td>@Ui.FileSize(d.SizeBytes)</td>
                                            <td>@if (d.ExpiryDate is null) { <text>—</text> } else { <span class="@(expired ? "text-danger fw-semibold" : null)">@Ui.Date(d.ExpiryDate)</span> }</td>
                                            <td>@Ui.Date(d.CreatedAt)</td>
                                            <td class="text-end">
                                                @if (canManage)
                                                {
                                                    <form method="post" asp-action="DeleteDocument" asp-route-id="@Model.Id" asp-route-documentId="@d.Id"
                                                          data-confirm="Remove '@d.Title' from this employee's documents?" data-confirm-button="Remove" data-confirm-variant="danger">
                                                        <button class="btn btn-light btn-icon btn-sm border-0" aria-label="Remove document"><i class="bi bi-trash text-danger"></i></button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="history" role="tabpanel">
        <div class="card-pm">
            <div class="card-pm-header"><h2 class="card-pm-title">Employment history</h2></div>
            <div class="card-pm-body">
                @if (Model.EmploymentHistory.Count == 0)
                {
                    <p class="text-muted mb-0">No history recorded.</p>
                }
                else
                {
                    <ul class="list-clean d-grid gap-3">
                        @foreach (var h in Model.EmploymentHistory)
                        {
                            var icon = h.ChangeType switch
                            {
                                EmploymentChangeType.Hired => "bi-person-plus text-success",
                                EmploymentChangeType.Termination => "bi-person-x text-danger",
                                EmploymentChangeType.Promotion => "bi-arrow-up-circle text-success",
                                EmploymentChangeType.Demotion => "bi-arrow-down-circle text-warning",
                                EmploymentChangeType.Transfer => "bi-arrow-left-right text-primary",
                                _ => "bi-circle text-muted"
                            };
                            <li class="d-flex gap-3">
                                <i class="bi @icon fs-5"></i>
                                <div>
                                    <div class="fw-semibold">@Ui.Humanize(h.ChangeType) <span class="text-muted fw-normal">· @Ui.Date(h.EffectiveDate)</span></div>
                                    <div class="small text-muted">
                                        @if (h.FromDepartment != h.ToDepartment && (h.FromDepartment ?? h.ToDepartment) is not null)
                                        {
                                            <div>Department: @(h.FromDepartment ?? "—") → @(h.ToDepartment ?? "—")</div>
                                        }
                                        @if (h.FromPosition != h.ToPosition && (h.FromPosition ?? h.ToPosition) is not null)
                                        {
                                            <div>Job title: @(h.FromPosition ?? "—") → @(h.ToPosition ?? "—")</div>
                                        }
                                        @if (h.FromStatus is not null || h.ToStatus is not null)
                                        {
                                            <div>Status: @(h.FromStatus is null ? "—" : Ui.Humanize(h.FromStatus.Value)) → @(h.ToStatus is null ? "—" : Ui.Humanize(h.ToStatus.Value))</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(h.Notes))
                                        {
                                            <div>@h.Notes</div>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@if (canChangeStatus && !isTerminated)
{
    <div class="modal fade" id="terminateModal" tabindex="-1" aria-labelledby="terminateTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-action="Terminate" asp-route-id="@Model.Id">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="terminateTitle">Terminate @Model.FullName</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-grid gap-3">
                    <div class="alert alert-danger small mb-0">Termination is recorded permanently, removes the employee from future payrolls and disables their system login.</div>
                    <div>
                        <label class="form-label" for="terminationDate">Last working day</label>
                        <input class="form-control" type="date" id="terminationDate" name="terminationDate" value="@Ui.TodayLocal().ToString("yyyy-MM-dd")" required />
                    </div>
                    <div>
                        <label class="form-label" for="terminationReason">Reason</label>
                        <textarea class="form-control" id="terminationReason" name="reason" rows="3" maxlength="500" required placeholder="e.g. Resignation, end of contract, dismissal"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Terminate employee</button>
                </div>
            </form>
        </div>
    </div>
}
