@using PayMaster.Application.Statutory
@model PayMaster.Web.ViewModels.Statutory.StatutoryEditViewModel
@{
    ViewData["Title"] = "Edit statutory version";
    var input = Model.Input;
    while (input.Bands.Count < 7) { input.Bands.Add(new TaxBandInput()); }
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Statutory Settings</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">Draft</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>
<div class="page-header">
    <div>
        <h1 class="page-title">Edit draft version</h1>
        <p class="page-subtitle">Rates are entered as percentages, limits in KES per month. Empty band rows are ignored. Changes take effect only after activation.</p>
    </div>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row gap-row">
        <div class="col-xl-6">
            <section class="card-pm mb-4">
                <div class="card-pm-header"><h2 class="card-pm-title">Version details</h2></div>
                <div class="card-pm-body row g-3">
                    <div class="col-md-8"><label class="form-label" asp-for="Input.Name">Name</label><input asp-for="Input.Name" class="form-control" required /></div>
                    <div class="col-md-4"><label class="form-label" asp-for="Input.EffectiveFrom">Effective from</label><input asp-for="Input.EffectiveFrom" type="date" class="form-control" required /></div>
                    <div class="col-12"><label class="form-label" asp-for="Input.Description">Description</label><input asp-for="Input.Description" class="form-control" /></div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Input.LegalReference">Legal references</label>
                        <textarea asp-for="Input.LegalReference" class="form-control" rows="4" placeholder="Acts, Finance Act sections, KRA / SHA / NSSF public notices verified"></textarea>
                    </div>
                </div>
            </section>
            <section class="card-pm mb-4">
                <div class="card-pm-header"><div><h2 class="card-pm-title">PAYE bands (monthly)</h2><p class="card-pm-subtitle">Each band starts where the previous ends; leave "To" empty on the last band.</p></div></div>
                <div class="card-pm-body">
                    <table class="table table-pm">
                        <thead><tr><th>#</th><th>From (KES)</th><th>To (KES)</th><th>Rate (%)</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < input.Bands.Count; i++)
                        {
                            <tr>
                                <td class="text-muted">@(i + 1)</td>
                                <td><input asp-for="Input.Bands[i].LowerBound" type="number" step="0.01" min="0" class="form-control form-control-sm" /></td>
                                <td><input asp-for="Input.Bands[i].UpperBound" type="number" step="0.01" min="0" class="form-control form-control-sm" /></td>
                                <td><input asp-for="Input.Bands[i].RatePercent" type="number" step="0.001" min="0" max="100" class="form-control form-control-sm" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-xl-6">
            @{ var index = 0; }
            @foreach (var group in StatutoryKeyMetadata.All.GroupBy(k => k.Group))
            {
                <section class="card-pm mb-4">
                    <div class="card-pm-header"><h2 class="card-pm-title">@group.Key</h2></div>
                    <div class="card-pm-body row g-3">
                        @foreach (var info in group)
                        {
                            var i = input.Rates.FindIndex(r => r.Key == info.Key);
                            if (i < 0) { input.Rates.Add(new StatutoryRateInput { Key = info.Key }); i = input.Rates.Count - 1; }
                            var rate = input.Rates[i];
                            <div class="col-md-6">
                                <input type="hidden" name="Input.Rates[@index].Key" value="@rate.Key" />
                                <label class="form-label" for="rate-@index">@info.Label @(info.Required ? "*" : "")</label>
                                @if (info.Unit == StatutoryValueUnit.Flag)
                                {
                                    <select id="rate-@index" name="Input.Rates[@index].Value" class="form-select">
                                        <option value="1" selected="@(rate.Value == 1)">Yes</option>
                                        <option value="0" selected="@(rate.Value != 1)">No</option>
                                    </select>
                                }
                                else
                                {
                                    <div class="input-group">
                                        @if (info.Unit == StatutoryValueUnit.Amount) { <span class="input-group-text">KSh</span> }
                                        <input id="rate-@index" name="Input.Rates[@index].Value" type="number" step="0.0001" min="0" value="@rate.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
                                        @if (info.Unit == StatutoryValueUnit.Percent) { <span class="input-group-text">%</span> }
                                    </div>
                                }
                                <input type="hidden" name="Input.Rates[@index].Notes" value="@rate.Notes" />
                                <div class="form-text">@info.Help</div>
                            </div>
                            index++;
                        }
                    </div>
                </section>
            }
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 border-top pt-3">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save draft</button>
    </div>
</form>
