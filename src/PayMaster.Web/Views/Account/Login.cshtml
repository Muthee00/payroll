@model PayMaster.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<div class="d-lg-none d-flex align-items-center gap-2 mb-4">
    <span class="brand-mark"><i class="bi bi-wallet2"></i></span>
    <span class="fw-bold fs-5">PayMaster</span>
</div>

<h1>Welcome back</h1>
<p class="text-muted mb-4">Sign in to manage payroll, people and performance.</p>

<form method="post" asp-action="Login" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Work email</label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" class="form-control" type="email" autocomplete="username" autofocus placeholder="you@company.co.ke" />
        </div>
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between">
            <label asp-for="Password" class="form-label">Password</label>
            <a asp-action="ForgotPassword" class="small fw-semibold">Forgot password?</a>
        </div>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" placeholder="••••••••••" />
        </div>
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">Keep me signed in for 14 days</label>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2">Sign in</button>
</form>
