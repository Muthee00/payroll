@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}
<div class="empty-state text-start px-0">
    <span class="empty-icon"><i class="bi bi-envelope-check"></i></span>
    <h1 class="fs-3">Check your email</h1>
    <p class="mb-4">If an active account exists for that address, a password reset link is on its way. The link expires in 2 hours.</p>
    <a asp-action="Login" class="btn btn-primary">Back to sign in</a>
</div>
