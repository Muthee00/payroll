@model PayMaster.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<a asp-action="Login" class="small fw-semibold d-inline-flex align-items-center gap-1 mb-4"><i class="bi bi-arrow-left"></i> Back to sign in</a>
<h1>Reset your password</h1>
<p class="text-muted mb-4">Enter your work email and we'll send you a link to choose a new password.</p>

<form method="post" asp-action="ForgotPassword" novalidate>
    <div class="mb-4">
        <label asp-for="Email" class="form-label">Work email</label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" class="form-control" type="email" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100 py-2">Send reset link</button>
</form>
